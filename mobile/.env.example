# DietAI Mobile Environment Configuration
# Copy this file to .env for local overrides (.env is gitignored).

# Production HTTPS API endpoint (enforced automatically when !__DEV__)
EXPO_PUBLIC_API_URL=https://api.dietai.app/api/v1

# For local LAN development (__DEV__), you may use:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api/v1

# Toggle deterministic local mock engine ('true' or 'false')
EXPO_PUBLIC_USE_MOCK_DATA=true
