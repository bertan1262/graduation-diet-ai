PROJECT_NAME="DietAI Backend"
PORT=8000
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# JWT Auth
SECRET_KEY=generate_a_very_secure_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Relational Database (PostgreSQL) — Users, Onboarding Profiles, Meal Logs
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/diet_ai_db

# NoSQL Database (MongoDB) — Chat History ("last chats") & Guardrail Audit Logs
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=diet_ai_nosql
CHAT_HISTORY_LIMIT=10

# Local AI Service (/ai-service)
AI_SERVICE_URL=http://localhost:8001
AI_CHAT_PATH=/api/v1/llm/chat
AI_DETECT_PATH=/api/v1/cv/detect
AI_SERVICE_TIMEOUT_SECONDS=60
AI_MOCK_FALLBACK=true
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=512

CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","*"]
